# CareFlow — Environment Configuration

# Copy this file to .env:   cp .env.example .env

# Then customize the values below as needed.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ASGI_APP=config.asgi:application

# PostgreSQL 
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=careflow_db
POSTGRES_USER=careflow_user
POSTGRES_PASSWORD=password

# Redis
REDIS_URL=redis://redis:6379/0
